    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "blEfn0ZSM6Fq"
      },
      "source": [
        "#Exportar el modelo al explorador! (Mas detalle de esto en en mi video de exportacion: https://youtu.be/JpE4bYyRADI )\n",
        "#modelo.save('numeros_regular.h5')\n",
