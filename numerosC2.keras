      "cell_type": "markdown",
      "metadata": {
        "id": "68fbef29"
      },
      "source": [
        "## Hacer la predicción\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8f6914d0",
        "outputId": "615c2f8c-4bfb-439e-8453-94db8b00c4b9"
      },
      "source": [
        "# Load the trained model\n",
        "modelo_cargado = tf.keras.models.load_model('numerosD1.keras')\n",
        "\n",
        "# Make a prediction\n",
        "predicciones = modelo_cargado.predict(img_final)\n",
        "\n",
        "# Get the predicted class index\n",
        "predicted_class_index = np.argmax(predicciones[0])\n",
        "\n",
        "print(f\"Predicted class probabilities: {predicciones[0]}\")\n",
        "print(f\"Predicted digit: {predicted_class_index}\")"
      ],
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
