    {
      "cell_type": "markdown",
      "source": [
        "## Preprocesamiento de la imagen"
      ],
      "metadata": {
        "id": "LMiXSOT5FrUV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import requests\n",
        "from PIL import Image\n",
        "import numpy as np\n",
        "\n",
        "# Download the image\n",
        "image_url = \"https://raw.githubusercontent.com/adiacla/bigdata/refs/heads/master/numero7a.jpg\"\n",
        "response = requests.get(image_url, stream=True)\n",
        "response.raise_for_status() # Raise an exception for bad status codes\n",
        "\n",
        "# Open the image\n",
        "img = Image.open(response.raw)\n",
        "\n",
        "# Convert to grayscale\n",
        "img_gray = img.convert('L')\n",
        "\n",
        "# Resize the image\n",
        "img_resized = img_gray.resize((28, 28))\n",
        "\n",
        "# Convert to numpy array\n",
        "img_array = np.array(img_resized)\n",
        "\n",
        "# Normalize the image\n",
        "img_normalized = img_array / 255.0\n",
        "\n",
        "# Expand dimensions to match model input shape (batch size, height, width, channels)\n",
        "img_final = np.expand_dims(img_normalized, axis=0)\n",
        "img_final = np.expand_dims(img_final, axis=-1)\n",
        "\n",
        "print(\"Image preprocessed successfully.\")\n",
        "print(f\"Shape of the preprocessed image: {img_final.shape}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "LMUqIwIyFtys",
        "outputId": "70a25122-b9d3-409e-d130-8dbaaf9b4982"
      },
      "execution_count": 14,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Image preprocessed successfully.\n",
            "Shape of the preprocessed image: (1, 28, 28, 1)\n"
          ]
        }
      ]
    },
